# ==========================================================================
# agentic-testing-panel — variables de entorno
# Copiar este archivo como .env.local y completar los valores.
# ==========================================================================

# --- Supabase -------------------------------------------------------------
# Project Settings > API en el dashboard de Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: NUNCA exponer al cliente. Solo se usa en API routes / worker.
SUPABASE_SERVICE_ROLE_KEY=

# --- Provider LLM ---------------------------------------------------------
# "anthropic" (default) usa la API directa. "openrouter" rutea via el
# endpoint compatible de OpenRouter (mismo SDK, cambia baseURL + apiKey +
# IDs de modelo). Usar OpenRouter cuando Anthropic no acepta pago o hay
# que consumir modelos de otro provider (openai/, google/, meta-llama/).
LLM_PROVIDER=anthropic

# --- Anthropic (obligatorio si LLM_PROVIDER=anthropic) --------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ORCHESTRATOR=claude-sonnet-4-6
ANTHROPIC_MODEL_SUBAGENT=claude-haiku-4-5
ANTHROPIC_MODEL_EVALUATOR=claude-haiku-4-5

# --- OpenRouter (obligatorio si LLM_PROVIDER=openrouter) ------------------
# IDs con prefijo del vendor: anthropic/, openai/, google/, meta-llama/...
# Los defaults apuntan a las mismas versiones de Claude que arriba.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ORCHESTRATOR=anthropic/claude-sonnet-4.5
OPENROUTER_MODEL_SUBAGENT=anthropic/claude-haiku-4.5
OPENROUTER_MODEL_EVALUATOR=anthropic/claude-haiku-4.5

# --- Configuracion del agente ---------------------------------------------
AGENT_MAX_ITERATIONS=3
AGENT_TIMEOUT_MS=60000

# --- Webhooks / jobs -------------------------------------------------------
# CRON_SECRET protege el endpoint /api/jobs/process (header x-cron-secret).
CRON_SECRET=
# WEBHOOK_SIGNING_SECRET firma (HMAC) los webhooks salientes.
WEBHOOK_SIGNING_SECRET=

# --- Cliente activo (multi-tenant) ----------------------------------------
# Slug del cliente que opera este worktree/deploy. Se envia como header
# X-Client-Slug en cada request a Supabase y dispara las policies de RLS
# que aislan los datos por cliente (ver supabase/migrations/004).
# Convencion: snake_case, sin espacios. Ej: 'ibath', 'quintaglia'.
NEXT_PUBLIC_CLIENT_SLUG=

# --- App -------------------------------------------------------------------
# URL base de la app (usada por el auto-trigger del worker en local).
# En produccion: la URL de Vercel. En local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
